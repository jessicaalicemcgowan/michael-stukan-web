# Copy this file to .env.local (which is gitignored) and fill in real
# values. Restart `next dev` after editing.

# --- Sanity -------------------------------------------------------------
# Project ID and org are already created (Michael Stukan / l4rsghr1).
# NEXT_PUBLIC_* because the Studio and client run in the browser too.
NEXT_PUBLIC_SANITY_PROJECT_ID=l4rsghr1
# Confirm this in manage.sanity.io -> your project -> Datasets. New
# projects default to a dataset literally named "production".
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# --- Shopify --------------------------------------------------------------
# Your dev store, for building/testing before this hands off to the
# client's own Shopify account.
SHOPIFY_STORE_DOMAIN=michaelstukan-dev.myshopify.com
# Create in Shopify Admin -> Settings -> Apps and sales channels ->
# Develop apps -> Create an app -> Configure Storefront API scopes
# (read products, read inventory) -> Install app -> reveal the
# Storefront API access token. Public-safe / read-only, not the Admin
# API secret.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
